# Образец deploy/.env. Скопируйте в deploy/.env и заполните. Файл .env в git не кладём.

# prod — сервер ЦЭУ (заглушки входа нет, нужен HTTPS). dev — локальная проверка с заглушкой входа.
OKO_PROFILE=prod
OKO_HTTP_PORT=80

# Пароль PostgreSQL (длинный случайный).
OKO_DB_PASSWORD=

# Origin, с которого открываются панель и iframe виджета, без / в конце. Например https://oko.tpu.ru
OKO_PUBLIC_ORIGIN=

# Логины ТПУ админов ЦЭУ через запятую. Пусто — админов нет.
OKO_ADMIN_LOGINS=

# Секрет HMAC для идентификаторов оценивших, не короче 32 символов: openssl rand -base64 48
# Смена секрета делает старые хэши несравнимыми (повторные оценки за 14 дней не будут пойманы).
OKO_RATER_HMAC_SECRET=

# Необязательно: параметры JVM и каталог со статикой панели и виджета.
# OKO_JAVA_OPTS=-Xmx1g -XX:+ExitOnOutOfMemoryError
# OKO_STATIC_DIR=./static
