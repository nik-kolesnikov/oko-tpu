# Copy to /opt/oko/.env (root:root, mode 600).
# GHCR image of the repository owner, lowercase: ghcr.io/<owner>/oko-tpu/backend:<dev|main>.
OKO_BACKEND_IMAGE=ghcr.io/reliksys/oko-tpu/backend:dev
OKO_DOMAIN=oko.example.org
OKO_ACME_EMAIL=admin@example.org
OKO_DB_PASSWORD=
OKO_RATER_HMAC_SECRET=
OKO_ADMIN_LOGINS=
# OKO_JAVA_OPTS=-Xmx1g -XX:+ExitOnOutOfMemoryError
