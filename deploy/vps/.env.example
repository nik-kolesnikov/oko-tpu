# Copy to /opt/oko/.env (root:root, mode 600).
# GHCR image of the repository owner, lowercase: ghcr.io/<owner>/oko-tpu/backend:<dev|main>.
OKO_BACKEND_IMAGE=ghcr.io/oko-tpu/oko-tpu/backend:dev
OKO_FRONTEND_IMAGE=ghcr.io/oko-tpu/oko-tpu/frontend:dev
# Published only after backend, frontend and deployment checks pass.
OKO_RELEASE_IMAGE=ghcr.io/oko-tpu/oko-tpu/release:dev
OKO_DOMAIN=oko.example.org
OKO_ACME_EMAIL=admin@example.org
OKO_DB_PASSWORD=
OKO_RATER_HMAC_SECRET=
OKO_MONITORING_EVENT_TOKEN=
OKO_ADMIN_LOGINS=
# Temporary admin login until TPU SSO: both empty = off. Password >= 16 chars (openssl rand -base64 24).
OKO_ADMIN_LOGIN=
OKO_ADMIN_PASSWORD=
# OKO_JAVA_OPTS=-Xmx1g -XX:+ExitOnOutOfMemoryError
