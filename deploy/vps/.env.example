# Copy to /opt/oko/.env (root:root, mode 600).
# Use the actual path from GitLab > Deploy > Container Registry, not the Git URL.
OKO_BACKEND_IMAGE=registry.example.org/oko/tpu_rating/backend:dev
OKO_DOMAIN=oko.example.org
OKO_ACME_EMAIL=admin@example.org
OKO_DB_PASSWORD=
OKO_RATER_HMAC_SECRET=
OKO_ADMIN_LOGINS=
